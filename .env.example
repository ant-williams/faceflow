# Copy to .env and fill in before `docker compose up`.
# .env is gitignored — never commit real passwords.

# Desktop login password (KasmVNC). Username is always "kasm_user".
FACEFLOW_PASSWORD=change-me-now

# Base image tag — a Kasm workspace core image tag.
# See: https://hub.docker.com/r/kasmweb/core-ubuntu-jammy/tags
BASE_TAG=1.16.1
