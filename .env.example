# Copy to .env and fill in before `docker compose up`.
# .env is gitignored — never commit real passwords.

FACEFLOW_USER=user
FACEFLOW_PASSWORD=change-me-now

# Base image tag — must be a real tag that exists for your host's CUDA/driver.
# See: https://github.com/selkies-project/docker-nvidia-egl-desktop
BASE_TAG=24.04-20260810151405

# Transport: KasmVNC (HTTP/WebSocket) works on RunPod and other HTTP-only hosts.
# Set to false only if you can provide host networking or a reachable TURN
# server for WebRTC/Selkies.
KASMVNC_ENABLE=true

# Stream quality
SELKIES_FRAMERATE=30
SELKIES_VIDEO_BITRATE=8000
